<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Eco Voltio</title>
<style>
:root {
  --dark: #123b2a;
  --green: #27ae60;
  --lime: #c5f36a;
  --bg: #f1f8ef;
  --white: #fff;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: var(--bg);
  color: var(--dark);
}
header {
  background: var(--dark);
  color: white;
  padding: 24px;
  text-align: center;
}
header h1 { margin: 0; font-size: 32px; }
header p { margin-bottom: 0; }
nav {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
  padding: 14px;
  background: #1d563b;
}
nav button {
  border: 0;
  border-radius: 20px;
  padding: 11px 16px;
  background: transparent;
  color: white;
  cursor: pointer;
  font-weight: bold;
}
nav button.active, nav button:hover {
  background: var(--lime);
  color: var(--dark);
}
main {
  max-width: 1050px;
  margin: 25px auto;
  padding: 0 16px;
}
.tab { display: none; }
.tab.active { display: block; }
.hero {
  background: linear-gradient(120deg, #174d34, #37a968);
  color: white;
  padding: 35px;
  border-radius: 20px;
  margin-bottom: 20px;
}
.hero h2 { font-size: 30px; }
.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(190px,1fr));
  gap: 15px;
}
.card {
  background: white;
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 3px 12px #123b2a12;
}
.card h3 { margin-top: 0; }
.number {
  font-size: 27px;
  font-weight: bold;
  color: var(--green);
}
form {
  background: white;
  padding: 20px;
  border-radius: 16px;
  margin: 15px 0;
}
input, select, textarea {
  display: block;
  width: 100%;
  padding: 12px;
  margin: 9px 0 15px;
  border: 1px solid #cbdaca;
  border-radius: 9px;
  font: inherit;
}
textarea { min-height: 90px; }
.action {
  background: var(--green);
  color: white;
  border: 0;
  border-radius: 9px;
  padding: 12px 18px;
  cursor: pointer;
  font-weight: bold;
}
.action:hover { background: var(--dark); }
.item {
  background: white;
  padding: 15px;
  border-radius: 12px;
  margin: 10px 0;
}
.item button { margin: 5px; }
.stars { color: #e6a817; font-size: 20px; }
footer {
  text-align: center;
  padding: 25px;
  color: #56715f;
}
</style>
</head>
<body>

<header>
  <h1>🌱 ECO VOLTIO</h1>
  <p>Pequeños cambios, grandes ahorros para el planeta.</p>
</header>

<nav>
  <button class="active" onclick="showTab('inicio',this)">Inicio</button>
  <button onclick="showTab('consumo',this)">Mi consumo</button>
  <button onclick="showTab('soluciones',this)">Soluciones</button>
  <button onclick="showTab('ahorro',this)">Mi ahorro</button>
  <button onclick="showTab('consejos',this)">Consejos</button>
  <button onclick="showTab('resenas',this)">Reseñas</button>
</nav>

<main>

<section id="inicio" class="tab active">
  <div class="hero">
    <h2>¡Bienvenido a Eco Voltio!</h2>
    <p>Controla tu consumo energético, descubre cómo reducirlo y calcula cuánto puedes ahorrar.</p>
  </div>
  <div class="cards">
    <div class="card">
      <h3>Gasto mensual</h3>
      <div class="number" id="homeGasto">0 €</div>
    </div>
    <div class="card">
      <h3>Ahorro estimado</h3>
      <div class="number" id="homeAhorro">0 €</div>
    </div>
    <div class="card">
      <h3>Gasto optimizado</h3>
      <div class="number" id="homeOptimizado">0 €</div>
    </div>
    <div class="card">
      <h3>Reseñas publicadas</h3>
      <div class="number" id="homeResenas">0</div>
    </div>
  </div>
</section>

<section id="consumo" class="tab">
  <h2>Mi consumo energético</h2>
  <p>Introduce tus gastos mensuales para conocer tu consumo.</p>
  <form id="consumoForm">
    <label>Sector</label>
    <select id="sector" required>
      <option value="Electricidad">Electricidad</option>
      <option value="Calefacción">Calefacción</option>
      <option value="Agua caliente">Agua caliente</option>
      <option value="Transporte">Transporte</option>
      <option value="Otros">Otros</option>
    </select>
    <label>Gasto mensual (€)</label>
    <input type="number" id="gasto" min="0" step="0.01" required>
    <button class="action">Añadir gasto</button>
  </form>
  <div id="listaConsumo"></div>
</section>

<section id="soluciones" class="tab">
  <h2>Soluciones para ahorrar</h2>
  <p>Añade medidas que quieras aplicar y estima cuánto ahorrarías al mes.</p>
  <form id="solucionForm">
    <label>Nombre de la solución</label>
    <input id="nombreSolucion" placeholder="Ej. Usar bombillas LED" required>
    <label>Sector</label>
    <select id="sectorSolucion">
      <option>Electricidad</option>
      <option>Calefacción</option>
      <option>Agua caliente</option>
      <option>Transporte</option>
      <option>Otros</option>
    </select>
    <label>Ahorro estimado mensual (€)</label>
    <input type="number" id="ahorroSolucion" min="0" step="0.01" required>
    <button class="action">Añadir solución</button>
  </form>
  <div id="listaSoluciones"></div>
</section>

<section id="ahorro" class="tab">
  <h2>Mi ahorro</h2>
  <div class="cards">
    <div class="card">
      <h3>Gasto actual</h3>
      <div class="number" id="gastoActual">0 €</div>
    </div>
    <div class="card">
      <h3>Ahorro este mes</h3>
      <div class="number" id="ahorroActual">0 €</div>
    </div>
    <div class="card">
      <h3>Ahorro mes anterior</h3>
      <div class="number" id="ahorroAnterior">0 €</div>
    </div>
    <div class="card">
      <h3>Gasto optimizado</h3>
      <div class="number" id="gastoFinal">0 €</div>
    </div>
  </div>
  <form id="mesAnteriorForm">
    <h3>Registrar ahorro del mes anterior</h3>
    <label>Ahorro del mes anterior (€)</label>
    <input type="number" id="anterior" min="0" step="0.01" required>
    <button class="action">Guardar</button>
  </form>
</section>

<section id="consejos" class="tab">
  <h2>Consejos ecológicos</h2>
  <div class="cards">
    <div class="card">
      <h3>💡 Electricidad</h3>
      <p>Apaga las luces cuando salgas de una habitación y utiliza bombillas LED.</p>
    </div>
    <div class="card">
      <h3>🌡️ Calefacción</h3>
      <p>Mejora el aislamiento y ajusta la temperatura para evitar consumos innecesarios.</p>
    </div>
    <div class="card">
      <h3>🚿 Agua</h3>
      <p>Reduce el tiempo de ducha y evita dejar el grifo abierto.</p>
    </div>
    <div class="card">
      <h3>🚲 Transporte</h3>
      <p>Camina, utiliza la bicicleta o el transporte público cuando sea posible.</p>
    </div>
  </div>
</section>

<section id="resenas" class="tab">
  <h2>Opiniones de la comunidad</h2>
  <div class="card">
    <h3>Valoración media</h3>
    <div class="number" id="mediaResenas">0 / 5</div>
    <p id="totalResenas">Todavía no hay reseñas.</p>
  </div>
  <form id="resenaForm">
    <h3>Publica tu opinión</h3>
    <label>Tu nombre o alias</label>
    <input id="alias" maxlength="30" required>
    <label>Valoración</label>
    <select id="valoracion">
      <option value="5">⭐⭐⭐⭐⭐ - Excelente</option>
      <option value="4">⭐⭐⭐⭐ - Muy buena</option>
      <option value="3">⭐⭐⭐ - Buena</option>
      <option value="2">⭐⭐ - Regular</option>
      <option value="1">⭐ - Mejorable</option>
    </select>
    <label>Comentario</label>
    <textarea id="comentario" maxlength="500" required></textarea>
    <button class="action">Publicar reseña</button>
  </form>
  <div id="listaResenas"></div>
</section>

</main>

<footer>
  <p>🌍 Eco Voltio · Cuida el planeta, cuida tu energía.</p>
</footer>

<script>
const guardar = (clave, valor) =>
  localStorage.setItem(clave, JSON.stringify(valor));

const leer = (clave, defecto) => {
  try {
    return JSON.parse(localStorage.getItem(clave)) ?? defecto;
  } catch {
    return defecto;
  }
};

let consumos = leer("eco_consumos", []);
let soluciones = leer("eco_soluciones", []);
let resenas = leer("eco_resenas", []);
let ahorroAnterior = leer("eco_anterior", 0);

function euros(valor) {
  return Number(valor).toLocaleString("es-ES", {
    style: "currency",
    currency: "EUR"
  });
}

function showTab(id, boton) {
  document.querySelectorAll(".tab").forEach(x => x.classList.remove("active"));
  document.querySelectorAll("nav button").forEach(x => x.classList.remove("active"));
  document.getElementById(id).classList.add("active");
  boton.classList.add("active");
}

document.getElementById("consumoForm").addEventListener("submit", e => {
  e.preventDefault();
  consumos.push({
    id: Date.now(),
    sector: document.getElementById("sector").value,
    gasto: Number(document.getElementById("gasto").value)
  });
  guardar("eco_consumos", consumos);
  e.target.reset();
  actualizar();
});

document.getElementById("solucionForm").addEventListener("submit", e => {
  e.preventDefault();
  soluciones.push({
    id: Date.now(),
    nombre: document.getElementById("nombreSolucion").value,
    sector: document.getElementById("sectorSolucion").value,
    ahorro: Number(document.getElementById("ahorroSolucion").value),
    activa: true
  });
  guardar("eco_soluciones", soluciones);
  e.target.reset();
  actualizar();
});

document.getElementById("mesAnteriorForm").addEventListener("submit", e => {
  e.preventDefault();
  ahorroAnterior = Number(document.getElementById("anterior").value);
  guardar("eco_anterior", ahorroAnterior);
  actualizar();
});

document.getElementById("resenaForm").addEventListener("submit", e => {
  e.preventDefault();
  resenas.unshift({
    id: Date.now(),
    alias: document.getElementById("alias").value.trim(),
    valoracion: Number(document.getElementById("valoracion").value),
    comentario: document.getElementById("comentario").value.trim()
  });
  guardar("eco_resenas", resenas);
  e.target.reset();
  actualizar();
});

function eliminarConsumo(id) {
  consumos = consumos.filter(x => x.id !== id);
  guardar("eco_consumos", consumos);
  actualizar();
}

function cambiarSolucion(id) {
  soluciones = soluciones.map(x =>
    x.id === id ? {...x, activa: !x.activa} : x
  );
  guardar("eco_soluciones", soluciones);
  actualizar();
}

function eliminarSolucion(id) {
  soluciones = soluciones.filter(x => x.id !== id);
  guardar("eco_soluciones", soluciones);
  actualizar();
}

function actualizar() {
  const gastoTotal = consumos.reduce((s, x) => s + x.gasto, 0);
  const ahorroTotal = soluciones
    .filter(x => x.activa)
    .reduce((s, x) => s + x.ahorro, 0);
  const ahorroAplicado = Math.min(gastoTotal, ahorroTotal);
  const optimizado = Math.max(0, gastoTotal - ahorroAplicado);

  document.getElementById("homeGasto").textContent = euros(gastoTotal);
  document.getElementById("homeAhorro").textContent = euros(ahorroAplicado);
  document.getElementById("homeOptimizado").textContent = euros(optimizado);
  document.getElementById("gastoActual").textContent = euros(gastoTotal);
  document.getElementById("ahorroActual").textContent = euros(ahorroAplicado);
  document.getElementById("ahorroAnterior").textContent = euros(ahorroAnterior);
  document.getElementById("gastoFinal").textContent = euros(optimizado);
  document.getElementById("homeResenas").textContent = resenas.length;

  document.getElementById("listaConsumo").innerHTML =
    consumos.map(x => `
      <div class="item">
        <strong>${escapar(x.sector)}</strong>: ${euros(x.gasto)}
        <button class="action" onclick="eliminarConsumo(${x.id})">Eliminar</button>
      </div>
    `).join("") || "<p>Aún no has añadido gastos.</p>";

  document.getElementById("listaSoluciones").innerHTML =
    soluciones.map(x => `
      <div class="item">
        <strong>${escapar(x.nombre)}</strong> (${escapar(x.sector)})
        <p>Ahorro estimado: ${euros(x.ahorro)} / mes</p>
        <label>
          <input type="checkbox" ${x.activa ? "checked" : ""}
            onchange="cambiarSolucion(${x.id})">
          Solución activa
        </label>
        <button class="action" onclick="eliminarSolucion(${x.id})">Eliminar</button>
      </div>
    `).join("") || "<p>Aún no has añadido soluciones.</p>";

  const media = resenas.length
    ? resenas.reduce((s, x) => s + x.valoracion, 0) / resenas.length
    : 0;
